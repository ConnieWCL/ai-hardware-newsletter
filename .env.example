# LLM：默认 Groq 免费层（https://console.groq.com/keys 注册即可免费获取）
# 免费额度 1000 请求/天，本项目每天仅调用 1 次，绰绰有余
LLM_API_KEY=gsk_xxxx
# 可选：整体切换 LLM 提供商（OpenAI 兼容接口均可），不设置则用 config.yaml 默认值
# 例：OpenRouter 免费模型  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=z-ai/glm-5.2:free
# 例：DeepSeek（付费，极便宜）LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_MODEL=
# SMTP（163 示例；password 填邮箱设置中生成的"授权码"，不是登录密码）
SMTP_USER=weixingyueli@163.com
SMTP_PASS=你的163授权码
SMTP_HOST=smtp.163.com
SMTP_PORT=465
# 收件人，多个用英文逗号分隔
DIGEST_TO=weixingyueli@163.com,xzwu4839@agent.qq.com
